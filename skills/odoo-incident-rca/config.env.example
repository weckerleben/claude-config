# odoo-incident-rca — config local, una vez por máquina.
#
# Copiá este archivo FUERA de ~/.claude (ese directorio es un repo git y acá
# pueden ir claves API):
#
#   mkdir -p ~/.config/odoo-incident-rca
#   cp config.env.example ~/.config/odoo-incident-rca/config.env
#
# Lugares donde se busca, en orden: $RCA_CONFIG, ~/.config/odoo-incident-rca/config.env,
# junto al skill. Los scripts lo leen solos; no hace falta "source" manual.
# Una variable definida en el entorno gana sobre este archivo.

# --- Instancias ---------------------------------------------------------------
# Lista de nombres de perfil, separados por espacio. El nombre en mayúsculas es
# el prefijo de todas las variables de abajo (v19 -> V19_*).
INSTANCES="v16 v19"

# La que se usa cuando no se pasa --instance, no hay $RCA_INSTANCE y el directorio
# actual no es el repo de ninguna instancia.
DEFAULT_INSTANCE=v19

# --- Perfil v19 ---------------------------------------------------------------
# Versión de Odoo: elige references/odoo<versión>.md.
V19_ODOO_VERSION=19
# Nombre del repo git (el basename del remote origin, sin .git). Si estás parado
# en ese repo, el skill elige esta instancia solo.
V19_REPO_MATCH=cashea-odoo-v19
# Checkout local, para deploys.sh y las ramas de fix. Opcional si corrés desde el repo.
#V19_REPO_DIR=/ruta/a/cashea-odoo-v19
# Dónde se guardan los análisis. Default: <repo>/docs/incidents
#V19_INCIDENTS_DIR=
# Target SSH de la instancia: NNNNNNN@<proyecto>.odoo.com. Se ve en Odoo.sh ->
# rama de producción -> botón "Connect" -> SSH. El número cambia con cada build.
V19_SSH_TARGET=
# Acceso de SOLO LECTURA al Odoo vivo (scripts/odoo_query.py).
# URL y DB no son secretos. API_KEY sí: usá una clave API (Preferencias ->
# Seguridad de la cuenta -> Clave API), de un usuario de solo lectura si podés.
# El script usa JSON-2 (/json/2) si la instancia lo tiene y JSON-RPC solo como
# respaldo; JSON-2 no necesita USER, JSON-RPC sí.
V19_URL=
V19_DB=
#V19_API_KEY=
#V19_USER=tu.usuario@cashea.app
# auto (default) | json2 | jsonrpc — forzar una API en vez de detectarla.
#V19_RPC_API=auto

# --- Perfil v16 ---------------------------------------------------------------
V16_ODOO_VERSION=16
V16_REPO_MATCH=cashea-odoo
#V16_REPO_DIR=/ruta/a/cashea-odoo
#V16_INCIDENTS_DIR=
V16_SSH_TARGET=
# Odoo 16 no tiene JSON-2: acá siempre se usa JSON-RPC, así que USER es obligatorio.
V16_URL=
V16_DB=
#V16_USER=tu.usuario@cashea.app
#V16_API_KEY=
